  <graph edgedefault="undirected">
    <node id="paper">
      <data key="d0">TDD Governance for Multi-Agent Code Generation via Prompt Engineering</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">EASE 2026 arXiv paper proposing AI-native TDD governance for multi-agent code generation.</data>
      <data key="d4">0</data>
    </node>
    <node id="problem">
      <data key="d0">Problem: unconstrained LLM coding is unstable</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">LLMs show non-determinism, hallucinations, reproducibility gaps, and weak process discipline.</data>
      <data key="d4">0</data>
    </node>
    <node id="gap">
      <data key="d0">Gap: tests are auxiliary, not enforceable constraints</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Existing LLM approaches use tests as prompts/evaluation but do not enforce full TDD discipline.</data>
      <data key="d4">0</data>
    </node>
    <node id="contribution">
      <data key="d0">Contribution: AI-native TDD framework</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Turns classical TDD principles into prompt-level and workflow-level governance mechanisms.</data>
      <data key="d4">0</data>
    </node>
    <node id="tdd">
      <data key="d0">Classical TDD</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Red-Green-Refactor micro-cycle where tests specify behavior before implementation.</data>
      <data key="d4">1</data>
    </node>
    <node id="red_green_refactor">
      <data key="d0">Red-Green-Refactor phase ordering</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">A disciplined cycle: failing test first, minimal code to pass, then behavior-preserving refactor.</data>
      <data key="d4">1</data>
    </node>
    <node id="principle_categories">
      <data key="d0">TDD principle categories</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Order, granularity, feedback quality, and design hygiene.</data>
      <data key="d4">1</data>
    </node>
    <node id="order_constraints">
      <data key="d0">Order constraints</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Test-first and Red→Green→Refactor sequencing.</data>
      <data key="d4">1</data>
    </node>
    <node id="granularity_constraints">
      <data key="d0">Granularity constraints</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Minimal failing test, minimal passing code, one failing test at a time.</data>
      <data key="d4">1</data>
    </node>
    <node id="feedback_quality">
      <data key="d0">Feedback-quality constraints</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">FAST, independent, repeatable, self-validating, timely tests with meaningful assertions.</data>
      <data key="d4">1</data>
    </node>
    <node id="design_hygiene">
      <data key="d0">Design hygiene constraints</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Remove duplication and refactor continuously while green.</data>
      <data key="d4">1</data>
    </node>
    <node id="manifesto">
      <data key="d0">Machine-readable TDD manifesto</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">JSON-style structured governance object with principle id, title, intent, AI-native interpretation, constraints, and anti-patterns.</data>
      <data key="d4">1</data>
    </node>
    <node id="architecture">
      <data key="d0">Governance-centric layered architecture</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Separates non-authoritative LLM proposal generation from authoritative engine-controlled mutation.</data>
      <data key="d4">2</data>
    </node>
    <node id="proposal_layer">
      <data key="d0">LLM proposal layer</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Planner, test, code, repair, and review agents propose structured outputs but cannot mutate workspace directly.</data>
      <data key="d4">2</data>
    </node>
    <node id="engine_governance">
      <data key="d0">Authoritative engine governance</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Engine owns validation, phase transitions, test runs, atomic apply, rollback, and state mutation.</data>
      <data key="d4">2</data>
    </node>
    <node id="planner">
      <data key="d0">Planner prompt/agent</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Decomposes requirements into ordered steps with expected test outcomes.</data>
      <data key="d4">3</data>
    </node>
    <node id="test_generation">
      <data key="d0">Test generation prompt/agent</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">RED-phase prompt restricted to tests with meaningful assertions aligned to the spec.</data>
      <data key="d4">3</data>
    </node>
    <node id="implementation">
      <data key="d0">Implementation prompt/agent</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">GREEN-phase prompt restricted to minimal code changes needed to satisfy failing tests.</data>
      <data key="d4">3</data>
    </node>
    <node id="failure_repair">
      <data key="d0">Failure repair prompt/agent</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Uses structured failure context for minimal localized corrections.</data>
      <data key="d4">3</data>
    </node>
    <node id="review">
      <data key="d0">Review prompt/agent</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Quality gate preventing over-specification, invented requirements, and phase pollution.</data>
      <data key="d4">3</data>
    </node>
    <node id="validation_gates">
      <data key="d0">Validation gates</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Schema/content checks, policy enforcement, phase consistency checks, and optional approval.</data>
      <data key="d4">2</data>
    </node>
    <node id="phase_gating">
      <data key="d0">Phase gating</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Code generation is not allowed until a failing test state exists; refactor is only allowed while green.</data>
      <data key="d4">2</data>
    </node>
    <node id="bounded_repair">
      <data key="d0">Bounded repair loops</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">At most N=3 repair attempts, with early termination for repeated failure signature, no effective change, or semantically equivalent proposals.</data>
      <data key="d4">3</data>
    </node>
    <node id="failure_signature">
      <data key="d0">Failure signature S</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Exception type, failing tests, normalized message; used to detect repeated failures.</data>
      <data key="d4">3</data>
    </node>
    <node id="deterministic_tests">
      <data key="d0">Deterministic test run</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Engine executes tests as an authoritative verifier after approved proposals.</data>
      <data key="d4">2</data>
    </node>
    <node id="atomic_mutation">
      <data key="d0">Atomic apply / rollback</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">All file mutations are performed atomically by the engine after validation; rollback protects refactoring.</data>
      <data key="d4">2</data>
    </node>
    <node id="runtime_enforcement">
      <data key="d0">Runtime enforcement mechanisms</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Planner-ordered FAIL gating, scope restrictions, no-op/unrelated-change rejection, post-apply tests, rollback.</data>
      <data key="d4">2</data>
    </node>
    <node id="prompt_distribution">
      <data key="d0">Prompt distribution across roles</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Governance invariants are distributed across system, planner, test generation, implementation, failure repair, and review prompts.</data>
      <data key="d4">3</data>
    </node>
    <node id="benefit">
      <data key="d0">Benefits claimed</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Reduced uncontrolled iteration, improved stability/reproducibility, less speculative code expansion, auditable AI-assisted development.</data>
      <data key="d4">0</data>
    </node>
    <node id="limitations">
      <data key="d0">Limitations</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Prompt-level enforcement only partial; empirical validation preliminary; cross-model/repository-scale evaluation needed; strict governance may limit exploration.</data>
      <data key="d4">0</data>
    </node>
    <node id="future_work">
      <data key="d0">Future work</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Repository-scale industrial settings, CI/CD integration, configurable governance levels, regulated-domain auditability.</data>
      <data key="d4">0</data>
    </node>
    <node id="related_tdflow">
      <data key="d0">TDFlow</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Related agentic TDD workflow; this paper emphasizes governed execution under non-determinism.</data>
      <data key="d4">4</data>
    </node>
    <node id="related_ticoder">
      <data key="d0">TiCoder</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Related interactive TDD-style test refinement and code generation.</data>
      <data key="d4">4</data>
    </node>
    <node id="related_llm4tdd">
      <data key="d0">LLM4TDD best practices</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Related practical guidance for TDD-style LLM use.</data>
      <data key="d4">4</data>
    </node>
    <node id="related_self_refine">
      <data key="d0">Self-Refine / structured CoT prompting</data>
      <data key="d1">paper</data>
      <data key="d2">paper_text.md</data>
      <data key="d3">Related prompt engineering loops that improve code generation quality but do not enforce full process discipline.</data>
      <data key="d4">4</data>
    </node>
