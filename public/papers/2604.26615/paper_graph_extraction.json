{
  "nodes": [
    {
      "id": "paper",
      "label": "TDD Governance for Multi-Agent Code Generation via Prompt Engineering",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "EASE 2026 arXiv paper proposing AI-native TDD governance for multi-agent code generation."
    },
    {
      "id": "problem",
      "label": "Problem: unconstrained LLM coding is unstable",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "LLMs show non-determinism, hallucinations, reproducibility gaps, and weak process discipline."
    },
    {
      "id": "gap",
      "label": "Gap: tests are auxiliary, not enforceable constraints",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Existing LLM approaches use tests as prompts/evaluation but do not enforce full TDD discipline."
    },
    {
      "id": "contribution",
      "label": "Contribution: AI-native TDD framework",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Turns classical TDD principles into prompt-level and workflow-level governance mechanisms."
    },
    {
      "id": "tdd",
      "label": "Classical TDD",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Red-Green-Refactor micro-cycle where tests specify behavior before implementation."
    },
    {
      "id": "red_green_refactor",
      "label": "Red-Green-Refactor phase ordering",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "A disciplined cycle: failing test first, minimal code to pass, then behavior-preserving refactor."
    },
    {
      "id": "principle_categories",
      "label": "TDD principle categories",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Order, granularity, feedback quality, and design hygiene."
    },
    {
      "id": "order_constraints",
      "label": "Order constraints",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Test-first and Red\u2192Green\u2192Refactor sequencing."
    },
    {
      "id": "granularity_constraints",
      "label": "Granularity constraints",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Minimal failing test, minimal passing code, one failing test at a time."
    },
    {
      "id": "feedback_quality",
      "label": "Feedback-quality constraints",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "FAST, independent, repeatable, self-validating, timely tests with meaningful assertions."
    },
    {
      "id": "design_hygiene",
      "label": "Design hygiene constraints",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Remove duplication and refactor continuously while green."
    },
    {
      "id": "manifesto",
      "label": "Machine-readable TDD manifesto",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "JSON-style structured governance object with principle id, title, intent, AI-native interpretation, constraints, and anti-patterns."
    },
    {
      "id": "architecture",
      "label": "Governance-centric layered architecture",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Separates non-authoritative LLM proposal generation from authoritative engine-controlled mutation."
    },
    {
      "id": "proposal_layer",
      "label": "LLM proposal layer",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Planner, test, code, repair, and review agents propose structured outputs but cannot mutate workspace directly."
    },
    {
      "id": "engine_governance",
      "label": "Authoritative engine governance",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Engine owns validation, phase transitions, test runs, atomic apply, rollback, and state mutation."
    },
    {
      "id": "planner",
      "label": "Planner prompt/agent",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Decomposes requirements into ordered steps with expected test outcomes."
    },
    {
      "id": "test_generation",
      "label": "Test generation prompt/agent",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "RED-phase prompt restricted to tests with meaningful assertions aligned to the spec."
    },
    {
      "id": "implementation",
      "label": "Implementation prompt/agent",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "GREEN-phase prompt restricted to minimal code changes needed to satisfy failing tests."
    },
    {
      "id": "failure_repair",
      "label": "Failure repair prompt/agent",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Uses structured failure context for minimal localized corrections."
    },
    {
      "id": "review",
      "label": "Review prompt/agent",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Quality gate preventing over-specification, invented requirements, and phase pollution."
    },
    {
      "id": "validation_gates",
      "label": "Validation gates",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Schema/content checks, policy enforcement, phase consistency checks, and optional approval."
    },
    {
      "id": "phase_gating",
      "label": "Phase gating",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Code generation is not allowed until a failing test state exists; refactor is only allowed while green."
    },
    {
      "id": "bounded_repair",
      "label": "Bounded repair loops",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "At most N=3 repair attempts, with early termination for repeated failure signature, no effective change, or semantically equivalent proposals."
    },
    {
      "id": "failure_signature",
      "label": "Failure signature S",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Exception type, failing tests, normalized message; used to detect repeated failures."
    },
    {
      "id": "deterministic_tests",
      "label": "Deterministic test run",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Engine executes tests as an authoritative verifier after approved proposals."
    },
    {
      "id": "atomic_mutation",
      "label": "Atomic apply / rollback",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "All file mutations are performed atomically by the engine after validation; rollback protects refactoring."
    },
    {
      "id": "runtime_enforcement",
      "label": "Runtime enforcement mechanisms",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Planner-ordered FAIL gating, scope restrictions, no-op/unrelated-change rejection, post-apply tests, rollback."
    },
    {
      "id": "prompt_distribution",
      "label": "Prompt distribution across roles",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Governance invariants are distributed across system, planner, test generation, implementation, failure repair, and review prompts."
    },
    {
      "id": "benefit",
      "label": "Benefits claimed",
      "file_type": "paper",
      "source_file": "paper_text.md",
      "description": "Reduced uncontrolled iteration, improved stability/reproducibility, less speculative code expansion, auditable AI-assisted development."
    },
    {
      "id": "limitations",
      "label": "Limitations",
      "file_type": "paper",
      "source_file": "paper_text.md",
